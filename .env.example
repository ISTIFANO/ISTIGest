# Database (PostgreSQL)
POSTGRES_DB=food_delivery
POSTGRES_USER=delivery_admin
POSTGRES_PASSWORD=change_me
POSTGRES_PORT=5432

# Spring datasource (app connects from host)
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/food_delivery
SPRING_DATASOURCE_USERNAME=delivery_admin
SPRING_DATASOURCE_PASSWORD=change_me

# RabbitMQ
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=change_me
RABBITMQ_QUEUE=delivery.queue
RABBITMQ_MANAGEMENT_PORT=15672

# pgAdmin
PGADMIN_DEFAULT_EMAIL=admin@fooddelivery.local
PGADMIN_DEFAULT_PASSWORD=change_me
PGADMIN_PORT=5050

# Spring Boot server
SERVER_PORT=8081
